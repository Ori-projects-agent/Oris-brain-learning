# Primary LLM Provider ("ollama" or "gemini")
LLM_PROVIDER=ollama

# Ollama Local Configuration (Default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Bigger local model for letters + nightly reflection (falls back to OLLAMA_MODEL if not pulled)
OLLAMA_DEEP_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
MAX_TOOLS_PER_TICK=8

# Modeling Workshop: coding model that writes Blender scripts + path to Blender
OLLAMA_CODE_MODEL=qwen2.5-coder:14b
BLENDER_PATH=C:\Path\To\blender-4.5.15-windows-x64

# Ollama Cloud Configuration (Optional: for running models ending in :cloud, e.g. gemma4:cloud)
# Set your API key from https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Gemini Configuration (Alternative cloud provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Autonomous Heartbeat Engine
TICK_INTERVAL_SECONDS=90
DB_PATH=ori_memory.db

# Web Solarium Interface
WEB_HOST=127.0.0.1
WEB_PORT=8888

# Astral Archive study game (same PC: http://localhost:8080 | other machine: http://<its-ip>:8080, Pi: :3000)
ASTRAL_ARCHIVE_URL=http://localhost:8080
